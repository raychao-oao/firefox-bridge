{
  "manifest_version": 2,
  "name": "firefox-bridge",
  "version": "0.1.0",
  "description": "Lets MCP-capable CLIs (Claude Code, Codex, etc.) operate your existing Firefox tabs.",
  "applications": {
    "gecko": {
      "id": "firefox-bridge@firefox-bridge.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "webNavigation",
    "webRequest",
    "storage",
    "scripting",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["policy-gate.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options/options.html"
  }
}
