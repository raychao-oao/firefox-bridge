{
  "manifest_version": 2,
  "name": "MCP Browser Bridge",
  "version": "0.3.5",
  "description": "Lets MCP-capable CLIs (Claude Code, Codex, etc.) operate your existing Firefox tabs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-bridge@firefox-bridge.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "webNavigation",
    "webRequest",
    "history",
    "bookmarks",
    "storage",
    "scripting",
    "contextualIdentities",
    "cookies",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["policy-gate.js", "bookmark-helpers.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options/options.html"
  }
}
